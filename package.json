{
  "name": "oliva",
  "version": "0.1.0",
  "private": true,
  "description": "Oliva - administration et carte publique de restaurant, stockage Excel local.",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "setup": "node --import tsx scripts/setup.ts",
    "admin:init": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/admin-init.ts",
    "demo:seed": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/demo-seed.ts",
    "base:verifier": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/db-check.ts",
    "storage:verifier": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/storage-check.ts",
    "storage:restaurer": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/storage-restore.ts",
    "i18n:verifier": "node scripts/i18n-extract.cjs",
    "test": "node --conditions=react-server --import tsx --test --test-concurrency=1 tests/unit/*.test.ts",
    "test:e2e": "node --import tsx tests/e2e/run.ts",
    "test:ui": "node --import tsx tests/ui/run.ts"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@vercel/blob": "^2.8.1",
    "exceljs": "^4.4.0",
    "next": "16.3.8",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "sonner": "^2.0.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "axe-core": "^4.13.0",
    "puppeteer-core": "^25.12.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  }
}
