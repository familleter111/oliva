# Copiez ce fichier vers .env.local (ou lancez `npm run setup`). Aucun secret réel ici.

# Secret technique (32 caractères minimum). Sert à signer les jetons de session et de protection CSRF.
# Générer une valeur : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
OLIVA_SECRET=

# Dossier de stockage privé (classeur Excel, médias, sauvegardes).
# En production : un chemin sur un disque persistant, hors du dossier public.
OLIVA_STORAGE_DIR=./storage

# URL publique du site, utilisée pour les QR codes et les liens d'invitation (ex. https://oliva.example).
OLIVA_PUBLIC_URL=http://localhost:3000

# Hébergement sans disque persistant (Vercel et semblables) : l'état va en base et les fichiers dans un dépôt Blob.
# Les deux valeurs sont fournies par l'hébergeur ; laissées vides, l'application utilise le dossier ci-dessus.
# DATABASE_URL=
# BLOB_READ_WRITE_TOKEN=

# Premier administrateur, lu uniquement par `npm run admin:init`.
# Retirez ces trois valeurs une fois le compte créé.
OLIVA_ADMIN_EMAIL=
OLIVA_ADMIN_PASSWORD=
OLIVA_ADMIN_NAME=

# Cookies marqués Secure en production. Ne passer à "false" que pour un test local en HTTP.
# OLIVA_COOKIE_SECURE=true
